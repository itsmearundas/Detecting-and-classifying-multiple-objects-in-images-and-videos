# Copy this file to .env for local development.
# Most hosting platforms (Render, Railway, Fly.io, etc.) let you set
# these as dashboard/CLI environment variables instead of a .env file.

# Comma-separated list of allowed origins for CORS, or "*" for any.
CORS_ORIGINS=*

# Max upload size in megabytes. Lower this on memory-constrained
# free-tier hosts (e.g. 100) to avoid OOM on large uploads.
MAX_CONTENT_LENGTH_MB=200

# Never enable debug mode in production.
FLASK_DEBUG=false
